[
  {"name": "negative unit cost", "level": "field", "browser": true,
   "ops": [{"op": "set", "path": "skus.0.unit_cost", "value": -1}],
   "expect": {"path": "skus.0.unit_cost", "message": "greater than 0"}},
  {"name": "fill rate above 1", "level": "field", "browser": true,
   "ops": [{"op": "set", "path": "suppliers.1.fill_rate_mean", "value": 1.5}],
   "expect": {"path": "suppliers.1.fill_rate_mean", "message": "less than or equal to 1"}},
  {"name": "unknown transport mode", "level": "field", "browser": true,
   "ops": [{"op": "set", "path": "lanes.3.mode", "value": "teleport"}],
   "expect": {"path": "lanes.3.mode", "message": "Input should be"}},
  {"name": "missing plant capacity", "level": "field", "browser": true,
   "ops": [{"op": "remove", "path": "plants.1.capacity_per_period"}],
   "expect": {"path": "plants.1.capacity_per_period", "message": "Field required"}},
  {"name": "latitude out of range", "level": "field", "browser": true,
   "ops": [{"op": "set", "path": "dcs.0.location.lat", "value": 95}],
   "expect": {"path": "dcs.0.location.lat", "message": "less than or equal to 90"}},
  {"name": "latitude without longitude", "level": "field", "browser": false,
   "ops": [{"op": "remove", "path": "markets.2.location.lon"}],
   "expect": {"path": "markets.2.location", "message": "give both lat and lon"}},
  {"name": "shelf life on an ambient SKU", "level": "field", "browser": false,
   "ops": [{"op": "set", "path": "skus.2.shelf_life_days", "value": 10}],
   "expect": {"path": "skus.2", "message": "must not have a shelf life"}},
  {"name": "sourcing shares not adding to 1", "level": "field", "browser": false,
   "ops": [{"op": "set", "path": "plants.0.sourcing.0.share", "value": 0.9}],
   "expect": {"path": "plants.0", "message": "sum to 1"}},
  {"name": "market served by a plant", "level": "reference", "browser": false,
   "ops": [{"op": "set", "path": "markets.0.served_by", "value": "PLANT_N"}],
   "expect": {"path": "markets.0.served_by", "message": "which is not a DC"}},
  {"name": "lane to an unknown node", "level": "reference", "browser": false,
   "ops": [{"op": "set", "path": "lanes.6.destination", "value": "DC_X"}],
   "expect": {"path": "lanes.6.destination", "message": "unknown node DC_X"}},
  {"name": "lane in the wrong direction", "level": "reference", "browser": false,
   "ops": [{"op": "set", "path": "lanes.12.origin", "value": "PLANT_N"}],
   "expect": {"path": "lanes.12.destination", "message": "which is not allowed"}},
  {"name": "duplicate node id", "level": "reference", "browser": false,
   "ops": [{"op": "set", "path": "dcs.2.id", "value": "DC_N"}],
   "expect": {"path": "dcs.2.id", "message": "node ids must be unique"}},
  {"name": "plant buys from a supplier with no lane", "level": "reference", "browser": false,
   "ops": [{"op": "remove", "path": "lanes.2"}],
   "expect": {"path": "plants.0.sourcing.1.supplier", "message": "no lane between them"}},
  {"name": "plant makes an unknown SKU", "level": "reference", "browser": false,
   "ops": [{"op": "set", "path": "plants.1.skus.0", "value": "S99"}],
   "expect": {"path": "plants.1.skus.0", "message": "makes S99"}},
  {"name": "demand override for an unknown market", "level": "reference", "browser": false,
   "ops": [{"op": "append", "path": "demand_overrides", "value": {"market": "MKT_X", "sku": "S01", "mean": 10}}],
   "expect": {"path": "demand_overrides.0", "message": "unknown market or SKU"}}
]
